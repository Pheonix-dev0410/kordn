{
  "name": "kordn",
  "private": true,
  "description": "Kordn: a local-first firewall that makes AI-agent permissions enforceable at the tool and OS boundary.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:adversarial": "vitest run --project adversarial --passWithNoTests",
    "test:concurrency": "vitest run --project concurrency --passWithNoTests",
    "sandbox:verify": "pnpm --filter @kordn/launcher verify",
    "demo:run": "pnpm --filter @kordn/launcher demo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
